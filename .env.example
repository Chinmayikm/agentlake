# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Required by services/gateway. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional -- defaults match docker-compose.yml. Only needed if your Kafka /
# Schema Registry run somewhere other than localhost.
# AGENTLAKE_KAFKA=localhost:9092
# AGENTLAKE_REGISTRY=http://localhost:8081

# Optional -- services/rag's QdrantStore. Defaults to docker-compose.yml's
# qdrant service.
# AGENTLAKE_QDRANT=http://localhost:6333

# Optional -- MinIO root credentials for the streaming profile's object store
# (docker-compose.yml). The defaults below are what compose falls back to, and
# they are fine for a laptop; set them here to use anything else. Flink and the
# Iceberg REST catalog both read them as AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# MINIO_ROOT_USER=agentlake
# MINIO_ROOT_PASSWORD=agentlake-dev-secret

# Optional -- Iceberg REST catalog for stream/flink/create_tables.py. Defaults
# to docker-compose.yml's iceberg-rest service.
# AGENTLAKE_ICEBERG_REST=http://localhost:8181

# Optional -- ClickHouse HTTP interface for the hot path (ADR-005): read by
# stream/clickhouse/bootstrap.py, scripts/hot_path_verify.py and
# services/mcp_server's get_trace/query_metrics. Defaults to
# docker-compose.yml's clickhouse service. This is the HTTP port; the native
# protocol on 9000 is reachable inside the compose network only (Grafana uses
# it) and is deliberately not published, so it cannot collide with MinIO.
# AGENTLAKE_CLICKHOUSE=http://localhost:8123

# Optional -- Grafana's admin password (the anonymous Viewer role needs no
# login at all; this is only for editing at /login). Defaults to "admin".
# GRAFANA_ADMIN_PASSWORD=admin
