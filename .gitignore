.venv/
__pycache__/
*.pyc
.env

# stream/flink: connector jars, ~172 MB, regenerable via `make flink-jars`
# (scripts/fetch_flink_jars.sh pins every URL and checksum).
stream/flink/lib/

# stream/flink: where stop.sh files each job's retained-checkpoint path so
# submit.sh --resume can find it. Machine-local state, not source.
stream/flink/.resume/

# services/rag: fetched docs, the sqlite corpus, and the fastembed model
# cache are all regenerable via `python -m services.rag ingest`.
services/rag/data/
docs/private/
data/

# dbt build output. target/ holds compiled SQL plus manifest.json and
# run_results.json -- which is exactly what dbt-ol post-processes into
# OpenLineage events, so it is real output, but it is regenerable by
# `make dbt-build`. dbt_packages/ is `dbt deps` (dbt_utils); package-lock.yml
# IS committed, because it pins the resolved package version.
dbt/target/
dbt/dbt_packages/
dbt/logs/
# Generated on first run: a random anonymous id dbt uses for its own telemetry.
# Machine-local, not source.
dbt/.user.yml
